    "./protocol": "./src/protocol/index.ts",
    "./geometry": "./src/geometry/index.ts",
    "./vision": "./src/vision/index.ts",
    "./movement": "./src/movement/index.ts",
    "./aoe": "./src/aoe/index.ts",
    "./dice": "./src/dice/index.ts",
    "./rules": "./src/rules/index.ts"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.34",
    "zod": "4.6.5"
  }
}
